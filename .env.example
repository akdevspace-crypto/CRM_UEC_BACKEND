# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="8h"

# Supabase Storage & Services
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# Omnichannel & Messaging
WHATSAPP_PHONE_ID="your-whatsapp-phone-id"
WHATSAPP_TOKEN="your-whatsapp-system-token"
EMAIL_USER="support@example.com"
EMAIL_PASS="your-email-app-password"

# Telephony Providers (Vobiz & Exotel)
TELEPHONY_PROVIDER="vobiz"
VOBIZ_TELEPHONY_ENABLED="true"
EXOTEL_TELEPHONY_ENABLED="false"
VOBIZ_API_BASE_URL="https://api.vobiz.ai"
VOBIZ_AUTH_ID="your-vobiz-auth-id"
VOBIZ_AUTH_TOKEN="your-vobiz-auth-token"
VOBIZ_SIP_DOMAIN="your-sip-domain.vobiz.ai"
VOBIZ_PHONE_NUMBER="+18000000000"
VOBIZ_WEBHOOK_PUBLIC_URL="https://api.example.com/vobiz/incoming"

# LiveKit WebRTC & Cloud SIP
LIVEKIT_API_URL="https://your-livekit-project.livekit.cloud"
LIVEKIT_WS_URL="wss://your-livekit-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_SIP_HOST="your-sip-domain.sip.livekit.cloud"
LIVEKIT_VOBIZ_OUTBOUND_TRUNK_ID="your-outbound-trunk-id"

# Twilio & SMS
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+18000000000"

# AI Post-Call Processing
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key"
